# AgriSmart assistant settings. This file is NOT committed (see .gitignore).
# To change the key: edit AI_API_KEY below, save, and build again with
#   flutter run --dart-define-from-file=.env
#   flutter build apk --dart-define-from-file=.env
#
# AI_PROVIDER: groq, deepseek, gemini, openai, anthropic or proxy
AI_PROVIDER=groq
AI_API_KEY=paste-your-key-here
AI_MODEL=llama-3.3-70b-versatile
# For a public website, leave AI_API_KEY empty and set this instead
# (see server/worker.js):
AI_PROXY_URL=
